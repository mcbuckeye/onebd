# Ignore data directory (contracts are large)
data/contracts/
data/*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.eggs/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Git: retain only non-secret commit metadata so deployed images can identify
# the exact checkout Dokploy built. All other .git content remains excluded.
.git/*
!.git/HEAD
!.git/refs/
!.git/refs/**
.gitignore

# Docker
.docker/

# Frontend (has its own build)
frontend/node_modules/
frontend/dist/

# Misc
*.log
*.tmp
.env.local
