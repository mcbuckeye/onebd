# Cortellis API Credentials
CORTELLIS_USERNAME=your_username
CORTELLIS_PASSWORD=your_password
CORTELLIS_BASE_URL=https://api.cortellis.com/api-ws/ws/rs

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cortellis
POSTGRES_USER=cortellis
POSTGRES_PASSWORD=change_this_secure_password

# OpenAI API (for AI query agent)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview

# Required for container deployments. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_64_hex_characters

# Email delivery: configure SendGrid OR SMTP. Leave both blank to disable.
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURITY=starttls
EMAIL_TIMEOUT_SECONDS=20
DIGEST_FROM_EMAIL=bd-intelligence@pchomelab.com
DIGEST_FROM_NAME=BD Intelligence
APP_URL=https://onebd.pchomelab.com

# Sync Schedule (cron format: minute hour day month day_of_week)
# Default: Daily at 2 AM
SYNC_SCHEDULE=0 2 * * *

# Contract document storage directory
CONTRACTS_DIR=/app/data/contracts
