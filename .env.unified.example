# BD Intelligence Platform - Unified Configuration
# Copy this file to .env.unified and fill in your values

# ============================================
# API KEYS
# ============================================

# OpenAI API key (required for embeddings and LLM)
OPENAI_API_KEY=sk-...

# OpenAI model for chat/extraction
OPENAI_MODEL=gpt-4o

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# CORTELLIS DATABASE
# ============================================

# Cortellis PostgreSQL credentials
CORTELLIS_DB=cortellis
CORTELLIS_USER=cortellis
CORTELLIS_PASSWORD=changeme

# Cortellis API credentials (for data sync)
CORTELLIS_API_USERNAME=your_username
CORTELLIS_API_PASSWORD=your_password
CORTELLIS_BASE_URL=https://api.cortellis.com/api-ws/ws/rs

# ============================================
# EDGAR DATABASE
# ============================================

# Edgar BD PostgreSQL credentials
EDGAR_DB=deals
EDGAR_USER=postgres
EDGAR_PASSWORD=postgres

# ============================================
# NEO4J GRAPH DATABASE
# ============================================

# Neo4j credentials
NEO4J_PASSWORD=bdplatform123

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=INFO
