# BD Intelligence Platform - Unified Configuration
# Copy this file to .env.unified and fill in your values

# ============================================
# API KEYS
# ============================================

# OpenAI API key (required for embeddings and LLM)
OPENAI_API_KEY=sk-...

# OpenAI model for chat/extraction
OPENAI_MODEL=gpt-4o

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# CORTELLIS DATABASE
# ============================================

# Cortellis PostgreSQL credentials
CORTELLIS_DB=cortellis
CORTELLIS_USER=cortellis
CORTELLIS_PASSWORD=changeme

# Cortellis API credentials (for data sync)
CORTELLIS_API_USERNAME=your_username
CORTELLIS_API_PASSWORD=your_password
CORTELLIS_BASE_URL=https://api.cortellis.com/api-ws/ws/rs
CORTELLIS_CATALOG_SCAN_WORKERS=8
CORTELLIS_CATALOG_REPAIR_LIMIT=30000
CORTELLIS_CONTRACT_SCAN_BATCH_SIZE=5000
CORTELLIS_CONTRACT_SCAN_WORKERS=8
CORTELLIS_DEAL_API_SCAN_BATCH_SIZE=5000
CORTELLIS_DEAL_API_SCAN_WORKERS=8

# ============================================
# EDGAR DATABASE
# ============================================

# Edgar BD PostgreSQL credentials
EDGAR_DB=deals
EDGAR_USER=postgres
EDGAR_PASSWORD=postgres

# ============================================
# NEO4J GRAPH DATABASE
# ============================================

# Neo4j credentials
NEO4J_PASSWORD=bdplatform123

# ============================================
# SOURCE HEALTH MONITORING
# ============================================

# Optional. Alert/recovery events are retained in PostgreSQL when blank.
SOURCE_HEALTH_WEBHOOK_URL=
SOURCE_HEALTH_ALERT_EMAIL=

# Configure either SendGrid or SMTP when SOURCE_HEALTH_ALERT_EMAIL is set.
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_FROM_EMAIL=bd-intelligence@pchomelab.com

# Freshness budgets used by the common source-job monitor.
CORTELLIS_FRESHNESS_WARN_HOURS=36
CORTELLIS_FRESHNESS_CRITICAL_HOURS=72
EDGAR_FRESHNESS_WARN_HOURS=48
EDGAR_FRESHNESS_CRITICAL_HOURS=96
GRAPH_FRESHNESS_WARN_HOURS=36
GRAPH_FRESHNESS_CRITICAL_HOURS=72

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=INFO
